# ── 本機轉錄（必填）───────────────────────────────
# pyannote 說話者分離模型權重
# 取得：https://huggingface.co/settings/tokens
# 注意：需先在以下兩個頁面同意條款，否則 token 無效：
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HUGGINGFACE_TOKEN=

# ── Whisper 模型（§9.1 實測後定案）────────────────
# 依本機記憶體選定，換電腦時執行一次：python3 scripts/setup-model.py
# 該腳本會寫入此值並只下載選定的模型（12GB 以上 large-v2，以下 large-v2-q5_0）
#   large-v2       記憶體峰值約 4.0GB（§9.1 定案）
#   large-v2-q5_0  記憶體峰值約 2.0GB（量化版，小記憶體機器用）
WHISPER_MODEL=

# ── 摘要、心智圖與標籤 ───────────────────────────
# 三項由同一次 claude -p 呼叫產生（逐字稿只需送一次，最省額度）
SUMMARY_PROVIDER=claude_cli
# §9.2 實測後定案
CLAUDE_CLI_MODEL=opus

# 未來若切換為 API，改 SUMMARY_PROVIDER=claude_api 並填入：
ANTHROPIC_API_KEY=

# ── Supabase（留空則僅本機運作，不影響轉錄）──────
# 本機上傳走 Postgres 直連，與 exercise-together 一致
# 取得：Supabase 後台 → Project Settings → Database → Connection string
#       → 選 "Session pooler"（不要選 Direct connection）→ 複製 URI
# 格式：postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# 注意：Direct connection 的 db.<PROJECT_REF>.supabase.co 是 IPv6-only，
#       一般網路環境解析不到，必須用 Session pooler。
DATABASE_URL=

# ── 論文 PDF 原檔與思辨紀錄（Supabase Storage，選填）
# 論文原檔存在 papers bucket、思辨練習紀錄存在 notes bucket
# Storage 無法用 DATABASE_URL 存取，需另走 Storage API
# 取得：Supabase 後台 → Project Settings → API Keys
#   SUPABASE_URL：專案網址，格式 https://<PROJECT_REF>.supabase.co
#   SUPABASE_SECRET_KEY：Secret keys 區的 sb_secret_...（或舊版的 service_role key）
# secret key 不受 RLS 限制，只能放本機，不可放進手機前端或版控
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── Telegram 推播（選填）─────────────────────────
# 轉錄完成或失敗時傳訊息到手機，只帶標題與狀態
# 平常存在資料庫 app_settings 表（換電腦不必重填），這裡通常留空；
# 填了會覆蓋資料庫的值。兩處都沒有則不推播
# token：Telegram 找 @BotFather 建 bot 取得
# chat_id：先傳一句話給 bot，再開 https://api.telegram.org/bot<token>/getUpdates
#          找 "chat":{"id":...} 的數字
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 手機端登入（白名單存 users 表，不放這裡）─────
GOOGLE_CLIENT_ID=
JWT_SECRET=
JWT_SALT=
