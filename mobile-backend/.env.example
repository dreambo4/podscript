# Railway 環境變數（於 Railway 專案的 Variables 設定，不要寫入 .env 提交）

# Supabase Postgres 直連（Session pooler，與本機 upload.py 一致）
# 取得：Supabase 後台 → Project Settings → Database → Connection string
#       → 選 "Session pooler"（Direct connection 是 IPv6-only，解析不到）
# 格式：postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Google 登入
GOOGLE_CLIENT_ID=

# JWT
JWT_SECRET=
JWT_SALT=

# CORS：允許呼叫此 API 的前端網域，多個以逗號分隔。
# 正式環境為 Firebase Hosting 網域；本機開發時加上 http://localhost:5000 之類。
# 未設或設錯會讓瀏覽器擋下所有請求（後端看得到請求，前端卻收不到回應）。
ALLOWED_ORIGINS=https://podscript.web.app
