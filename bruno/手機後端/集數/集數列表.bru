meta {
  name: 集數列表
  type: http
  seq: 1
}

get {
  url: {{mobileBase}}/api/episodes?limit=20&offset=0&sort=created_at&tag_mode=all
  body: none
  auth: bearer
}

params:query {
  limit: 20
  offset: 0
  sort: created_at
  tag_mode: all
  ~q: 
  ~case_sensitive: true
  ~whole_word: true
  ~tags: 
  ~tag: 
  ~channel: 
  ~kind: video
  ~favorites_only: true
  ~project: {{projectId}}
}

docs {
  每筆附 platform（apple／youtube／article／paper），前端據此標示文章與論文。
  每筆附 cover：{"svg": "...", "color": "#rrggbb"}，svg 為 viewBox 0 0 48 48 的內部元素（本機已過濾，前端顯示前再過濾一次）；尚未產生時為 null。
  sort：created_at／published_at
  kind：audio（音檔，YouTube、文章、論文以外的平台）／video（影片，YouTube）／article（文章）／paper（論文）；不帶則不篩選
  tag_mode：all（須同時包含全部標籤）／any（符合任一）
  project：研究專案 id（projects.id，UUID），只列出歸入該專案的集數；格式錯誤回 422
  tags 可重複多次，例如 tags=AI&tags=投資
  有 q 時每集多回傳：
    snippet：逐字稿第一個命中處前後各約 40 字，被截斷的一側加「…」；只命中標題時為 null
    match_count：逐字稿內命中次數（不分大小寫）
  沒有 q 時 snippet 一律為 null、match_count 為 0
  case_sensitive=true：大小寫須相符
  whole_word=true：全字拼寫須相符；「字」只算英數與底線，且只在關鍵字頭（尾）是英數時才檢查前（後）一字，
    所以「AI」不會命中「said」，但會命中「我的AI我」；中文關鍵字開不開結果相同
}

script:post-response {
  if (res.status === 200 && res.body.length) bru.setEnvVar("guid", res.body[0].episode_guid);
}

auth:bearer {
  token: {{token}}
}
