meta {
  name: 修改專案
  type: http
  seq: 3
}

put {
  url: {{mobileBase}}/api/projects/{{projectId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "減脂研究",
    "description": "飲食與訓練對體脂的影響"
  }
}

docs {
  修改專案名稱或說明；未帶的欄位不變。成功回 204。
  名稱空白或重複回 400；查無此專案回 404；projectId 不是 UUID 回 422。
}
